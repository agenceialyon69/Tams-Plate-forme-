{
  "name": "TAMS Console Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"]
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "auto",
      "credentials": {
        "telegramApi": {
          "id": "USE_EXISTING_CREDENTIAL",
          "name": "Telegram API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parser la commande Telegram\nconst input = $input.first();\nconst message = input.json.message || {};\nconst text = message.text || '';\nconst chatId = message.chat?.id;\nconst username = message.from?.username || 'unknown';\n\n// Extraire commande et prompt\nconst parts = text.trim().split(/\\s+/);\nconst command = (parts[0] || '').toLowerCase();\nconst prompt = parts.slice(1).join(' ');\n\n// Commandes valides\nconst validCommands = ['/status', '/studio_test', '/video', '/audio', '/image', '/gpu'];\nconst isValid = validCommands.includes(command);\n\nreturn {
  chatId,
  username,
  command: isValid ? command : 'unknown',\n  prompt: prompt || '',\n  originalText: text,
  timestamp: new Date().toISOString(),
  isValid,
};"
      },
      "id": "parse-command",
      "name": "Parser Commande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.command }}", "rightValue": "/status", "operator": "equal" }] }, "output": 0 },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.command }}", "rightValue": "/studio_test", "operator": "equal" }] }, "output": 1 },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.command }}", "rightValue": "/video", "operator": "equal" }] }, "output": 2 },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.command }}", "rightValue": "/audio", "operator": "equal" }] }, "output": 3 },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.command }}", "rightValue": "/image", "operator": "equal" }] }, "output": 4 },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.command }}", "rightValue": "/gpu", "operator": "equal" }] }, "output": 5 }
          ],
          "fallbackOutput": 6
        }
      },
      "id": "switch-commands",
      "name": "Router Commande",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [690, 300]
    },
    {
