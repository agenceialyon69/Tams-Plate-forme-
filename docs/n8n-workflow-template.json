    {
      "parameters": {
        "url": "https://workspaceapi-server-production-1334.up.railway.app/api/gpu/status",
        "method": "GET",
        "options": {}
      },
      "id": "http-gpu",
      "name": "GET /gpu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [910, 500]
    },
    {
      "parameters": {
        "jsCode": "// Formater la reponse pour Telegram et Google Sheets\nconst baseUrl = 'https://workspaceapi-server-production-1334.up.railway.app';\n\n// Recuperer les donnees du parser et de la reponse HTTP\nconst parserNode = $('Parser Commande').first();\nconst chatId = parserNode.json.chatId;\nconst username = parserNode.json.username;\nconst command = parserNode.json.command;\nconst prompt = parserNode.json.prompt;\n\nconst httpResult = $input.first().json;\n\n// Construire l'URL complete si URL relative\nlet mediaUrl = httpResult.url || httpResult.playable?.videoUrl || httpResult.playable?.audioUrl || httpResult.playable?.imageUrl || null;\nif (mediaUrl && !mediaUrl.startsWith('http')) {\n  mediaUrl = baseUrl + mediaUrl;\n}\n\n// Determiner statut\nconst status = httpResult.ok === true || httpResult.verdict === 'pass' ? 'success' : 'error';\nconst error = httpResult.error || httpResult.detail || '';\n\n// Construire message Telegram\nlet msg = '';\n\nif (status === 'success') {\n  if (command === '/status') {\n    msg = \\`✅ **Status TAMS**\\n\\nVerdict: ${httpResult.verdict}\\nRailway: ${httpResult.deployment?.railway ? 'Oui' : 'Non'}\\nDatabase: ${httpResult.env?.databaseConfigured ? 'Configuré' : 'Non'}\\nGPU: ${httpResult.env?.gpuVideoConfigured ? 'Oui' : 'Non'}\\n\\`;\n  } else if (command === '/studio_test') {\n    msg = \\`🎬 **Studio Self-Test**\\n\\nVerdict: ${httpResult.verdict}\\n\\`;\n    if (httpResult.playable?.videoUrl) msg += \\`Video: ${baseUrl}${httpResult.playable.videoUrl}\\n\\`;\n    if (httpResult.playable?.audioUrl) msg += \\`Audio: ${baseUrl}${httpResult.playable.audioUrl}\\n\\`;\n    if (httpResult.playable?.imageUrl) msg += \\`Image: ${httpResult.playable.imageUrl}\\n\\`;\n  } else if (command === '/video' && mediaUrl) {\n    msg = \\`🎬 **Vidéo générée**\\n\\nURL: ${mediaUrl}\\nEngine: ${httpResult.engine || 'ffmpeg'}\\n${httpResult.degraded ? '\\n⚠️ Fallback local' : ''}\\`;\n  } else if (command === '/audio' && mediaUrl) {\n    msg = \\`🎵 **Audio généré**\\n\\nURL: ${mediaUrl}\\nEngine: ${httpResult.engine || 'musicgen'}\\`;\n  } else if (command === '/image' && mediaUrl) {\n    msg = \\`🖼️ **Image générée**\\n\\nURL: ${mediaUrl}\\`;\n  } else if (command === '/gpu') {\n    msg = \\`🖥️ **GPU Workers**\\n\\n\\`;\n    (httpResult.workers || []).forEach(w => {\n      const icon = w.status === 'connected' ? '✅' : '❌';\n      msg += \\`${icon} ${w.kind}: ${w.status}\\n\\`;\n    });\n  }
} else {\n  msg = \\`❌ **Erreur**\\n\\nCommande: ${command}\\nErreur: ${error}\\`;\n}\n\n// Donnees Google Sheets\nconst sheetsRow = {\n  date: new Date().toISOString(),\n  chatId: String(chatId),\n  username,
  commande: command,
  prompt,
  statut: status,
  url: mediaUrl || '',\n  erreur: error\n};\n\nreturn { telegramMessage: msg, chatId, sheetsRow };"
      },
      "id": "format-response",
      "name": "Formater Réponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.telegramMessage }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-reply",
      "name": "Répondre Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1350, 250],
      "credentials": {
        "telegramApi": {
          "id": "USE_EXISTING_CREDENTIAL",
          "name": "Telegram API"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEETS_ID",
          "mode": "id"
        },
        "sheetName": "Sheet1",
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {
            "date": "={{ $json.sheetsRow.date }}",
            "chatId": "={{ $json.sheetsRow.chatId }}",
            "username": "={{ $json.sheetsRow.username }}",
            "commande": "={{ $json.sheetsRow.commande }}",
            "prompt": "={{ $json.sheetsRow.prompt }}",
            "statut": "={{ $json.sheetsRow.statut }}",
            "url": "={{ $json.sheetsRow.url }}",
            "erreur": "={{ $json.sheetsRow.erreur }}"
          }
        },
        "options": {}
      },
      "id": "google-sheets-log",
      "name": "Logger Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
