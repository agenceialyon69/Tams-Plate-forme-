# TAMS — Variables d'environnement
#
# IMPORTANT: SECURITY REQUIREMENTS
# - All users must authenticate (Supabase Auth)
# - Data is isolated per user (RLS policies)
# - CORS is restricted in production

# === SUPABASE (REQUIRED FOR AUTH) ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# === DATABASE ===
# Railway provides DATABASE_URL automatically with PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/database

# === SESSION ===
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32

# === PERSONAL ACCESS GATE (rend TAMS privé — projet personnel free-first) ===
# Mettre à "true" pour exiger un login avant tout accès (UI + API sensibles).
# Laisse toujours ouverts : /api/health, /api/healthz, /api/auth.
# Si "true" sans PASSWORD+SECRET -> fail-closed (503), jamais d'accès ouvert.
TAMS_PERSONAL_ACCESS_ENABLED=false
TAMS_PERSONAL_ACCESS_USERNAME=admin
# Mot de passe personnel (choisis-le fort). Ne jamais committer la vraie valeur.
TAMS_PERSONAL_ACCESS_PASSWORD=
# Secret long pour signer le cookie de session (openssl rand -base64 48).
TAMS_PERSONAL_ACCESS_SECRET=
# Durée de session en ms (optionnel, défaut 12h = 43200000).
TAMS_PERSONAL_ACCESS_MAX_AGE_MS=43200000

# === SERVER ===
PORT=8080
NODE_ENV=production
BASE_PATH=/

# === CORS (IMPORTANT FOR SECURITY) ===
# Production: MUST be set explicitly
ALLOWED_ORIGINS=https://your-app.railway.app
# Or use single frontend URL:
FRONTEND_URL=https://your-app.railway.app

# === DEVELOPMENT RUNTIME (FAIL-CLOSED) ===
# Keep false in production. Runtime routes also require a valid Supabase Bearer JWT.
TAMS_DEV_RUNTIME_ENABLED=false

# === AI FREE PROVIDERS (AT LEAST ONE REQUIRED FOR CHAT) ===
# Order: AI_BASE_URL → Ollama → Groq → Gemini → OpenRouter

# Explicit override (Ollama remote, custom gateway)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Ollama local (http://localhost:11434/v1) — 100% free
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3

# Groq — free quota, very fast (https://console.groq.com)
GROQ_API_KEY=

# Gemini — free quota (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenRouter — :free models only (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# === STUDIO GPU WORKERS ===
# External GPU workers for premium generation
# If not configured, TAMS uses free-first fallbacks (Pollinations, local WAV)

# Video generation worker (ComfyUI, AnimateDiff, LTX, Hunyuan)
STUDIO_GPU_VIDEO_URL=

# Audio generation worker (MusicGen, AudioLDM)
STUDIO_GPU_AUDIO_URL=

# Voice synthesis worker (Piper, Edge-TTS, XTTS, Coqui)
STUDIO_GPU_VOICE_URL=

# Vision worker (YOLO, SAM, OCR)
STUDIO_GPU_VISION_URL=

# Generic GPU worker (fallback for any kind)
STUDIO_GPU_GENERAL_URL=

# Image generation worker (Stable Diffusion, Flux local)
STUDIO_GPU_IMAGE_URL=

# === COMFYUI ===
# ComfyUI server for custom workflows
# ComfyUI API address (not the UI)
COMFYUI_BASE_URL=
# Example: http://comfyui-server:8188

# === N8N AUTOMATION ===
# n8n webhook for external workflow automation
N8N_WEBHOOK_URL=

# === HUGGINGFACE ===
# For MusicGen, TTS, and other HF models
HF_TOKEN=
HUGGINGFACE_API_KEY=

# === MONITORING ===
# Sentry error tracking (optional)
SENTRY_DSN=

# Log level (debug, info, warn, error)
LOG_LEVEL=info
